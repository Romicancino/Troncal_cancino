<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>electivos diseño</title>
        <style>
            body {
                font-family: Helvetica, Arial, sans-serif; 
                margin: 20px;
            }
            h1 {
                font-family: 'DM Serif Display', Georgia, serif;
                color: #f08080;
                font-size: 2.4rem;
                margin-bottom: 1rem;
                letter-spacing: -0.5px;
            }
            
        
            table {
                border-collapse: collapse;
                width: 100%;
                max-width: 500px; 
                margin-top: 10px;
            }
            th, td {
                border: 1px solid #ddd;
                padding: 10px 15px;
                text-align: left;
            }
            th {
                background-color: #fce4e4; 
                color: #333;
                font-weight: bold;
            }
           
            tr:nth-child(even) {
                background-color: #f9f9f9;
            }
        </style>
    </head>
    <body>
        <h1> Mis electivos de Diseño .ೀ⠀</h1>
        
        <table></table>

        <script>
            const t = document.querySelector("table");
            const URL = "https://api.myjson.online/v1/records/a3ae9a40-3e80-4bf2-a952-5621d3393470";

            fetch(URL)
                .then((respuesta) => {
                    if (!respuesta.ok) {
                        throw new Error("Error HTTP: " + respuesta.status);
                    }
                    return respuesta.json();
                })
                .then((datos) => {
                    const trabajo = datos.data;
                    console.log("1. Datos recibidos:", trabajo);
                    
                    if (Array.isArray(trabajo)) {
                        // 
                        let contenidoTabla = `
                            <thead>
                                <tr>
                                    <th>N°</th>
                                    <th>Electivos</th>
                                </tr>
                            </thead>
                            <tbody>
                        `; 
                        
                        let contador = 1; 
                        
                        trabajo.forEach((x) => {
                            console.log("2. Analizando elemento:", x); 
                            
                            if (x.ok == 1) { 
                                contenidoTabla += `
                                    <tr>
                                        <td>${contador}</td>
                                        <td>${x.name}</td>
                                    </tr>
                                `;
                                contador++; 
                            }
                        });
                        
                        contenidoTabla += `</tbody>`;
                        
                        t.innerHTML = contenidoTabla;
                    } else {
                        console.error("Error: datos.data no es un Arreglo (Array), es un", typeof trabajo);
                    }
                })
                .catch((error) => {
                    console.error("Algo salió mal en el fetch:", error);
                });
        </script>
    </body>
</html>
